@startuml ROS2システム
skinparam componentStyle uml2
skinparam packageStyle rectangle

package "センサ・ドライバ層" {
  [livox_driver_MID360s] as Livox
  [realsense_dust_cloth] as RealSense
}

package "gn10-navigation" {
  [target_manager_node] as TargetMgr
  [costmap_generator_node] as CostmapGen
  [path_planner_node] as Planner
  [path_follower_node] as Follower
}

package "自己位置・認識層" {
  [gn10_pointcloud_localization] as Localizer
  [lidar_perception_system] as Perception
}

package "射出・解析系" {
  [launcher_speed_calculator] as LauncherCalc
  [雑巾解析node] as ClothAnalyzer
}

package "通信層" {
  [udp_node] as UDP
}

' --- データフロー ---

' 1. センサ & 自己位置
Livox --> Localizer : 点群・IMU
Localizer --> Planner : 自己位置 TF (map -> base_link)
Localizer --> Perception : 動的点群データ
Perception --> Follower : 移動バケツ座標 TF (map -> bucket_bottom)

' 2. メイン基板 (UDP) ↔ ナビゲーション
UDP --> TargetMgr : /robot/navigation_command\n/robot/target_id
UDP --> Follower : /robot/navigation_command\n/robot/target_id
TargetMgr --> Planner : /goal_pose (PoseStamped)
CostmapGen --> Planner : /costmap (OccupancyGrid)

Planner --> Follower : /planned_path (Path)
Follower --> UDP : /robot/operation/cmd_vel (Twist)\n/robot/operation/navigation_status (UInt8)

' 3. 射出制御 & 雑巾解析
RealSense --> ClothAnalyzer : 雑巾の追跡軌道
UDP --> ClothAnalyzer : ベルト直動の速度・電圧電流情報
LauncherCalc --> UDP : ベルト直動の速度指令値

' ノート
note top of LauncherCalc
  TFで base_link から相手ロボット/バケツへの
  相対座標を取得し、ベルト直動の指令値を計算
end note

note top of RealSense
  RealSenseに直接接続し
  射出された雑巾をカメラ追跡するノード
end note

note top of ClothAnalyzer
  射出時の状態・指令値・フィードバック・
  カメラ軌道を揃えて記録・解析するノード
end note

@enduml