@startuml ros2 node diagram

title ROS 2 Node Architecture & Inter-Process Communication

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam shadowing false
scale max 4500*3000

skinparam component {
  BackgroundColor #F8F9FA
  BorderColor #444444
  FontSize 12
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
  FontSize 13
  FontStyle bold
}

skinparam ArrowFontSize 11
skinparam NoteFontSize 11
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #BDBDBD

legend top left
  |<back:#1976D2>   </back> Navigation & Path Planning Commands |
  |<back:#388E3C>   </back> Sensor Data & TF Coordinate Frames |
  |<back:#E64A19>   </back> Hardware I/O & UDP Communication |
  |<back:#7B1FA2>   </back> Vision & Trajectory Analysis |
endlegend

' --- Sensor & Driver Domain ---
package "Sensor & Driver Domain" #EDE7F6 {
  component "3D LiDAR Driver\n[livox_ros_driver2]" as Livox #D1C4E9
  component "2D LiDAR Driver\n[lakibeam1_node]" as Lakibeam #D1C4E9
  component "Cloth Vision Tracker\n[cloth_tracker_cuda_node]" as RealSense #D1C4E9
}

' --- Localization & Perception Domain ---
package "Localization & Perception Domain" #E0F2F1 {
  component "3D/2D LiDAR Localization\n[gn10_pointcloud_localization_node]" as Localizer #80CBC4
  component "Bucket & Opponent Tracker\n[bucket_tracker / opening_guard]" as Perception #80CBC4
}

' --- Field Target & Coordinate Domain ---
package "Field Target Domain (field-targets-publisher)" #ECEFF1 {
  component "Field Target Publisher\n[field_target_node]" as FieldTarget #CFD8DC
}

' --- Navigation Domain (gn10_navigation) ---
package "Navigation Domain (gn10_navigation)" #E3F2FD {
  component "Target Manager\n[target_manager_node]" as TargetMgr #BBDEFB
  component "Costmap Generator\n[costmap_generator_node]" as CostmapGen #BBDEFB
  component "Path Planner (A*)\n[path_planner_node]" as Planner #BBDEFB
  component "Path Follower (Pure Pursuit + P)\n[path_follower_node]" as Follower #BBDEFB
  component "Moving Bucket Launcher\n[moving_bucket_launcher_node]" as MovingLauncher #BBDEFB
}

' --- Launcher & Shot Management Domain ---
package "Launcher & Shot Management Domain" #FFF3E0 {
  component "Shot Trial Manager\n[trial_recorder_node]" as ShotMgr #FFE0B2
}

' --- Communication Domain (robot_port) ---
package "Communication Domain (robot_port)" #F5F5F5 {
  component "UDP Bridge Node\n[udp_node]" as UDP #E0E0E0
}

' --- Connections: Sensor & Localization ---
Livox -[#388E3C]-> Localizer : 3D Point Cloud & IMU\n(/livox/lidar, /livox/imu)
Lakibeam -[#388E3C]-> Localizer : 2D Laser Scan\n(/lakibeam/scan)
Localizer -[#388E3C]-> Perception : Dynamic Point Cloud\n(/dynamic_cloud)
Localizer -[#388E3C]-> Planner : Robot Pose TF\n(map -> base_link)
Localizer -[#388E3C]-> Follower : Robot Pose TF\n(map -> base_link)
Localizer -[#388E3C]-> FieldTarget : Robot Pose TF\n(map -> base_link)
Localizer -[#388E3C]-> MovingLauncher : Robot Pose TF\n(map -> base_link)
Localizer -[#E64A19]-> UDP : Localization Status\n(/robot/operation/localization_success)

' --- Connections: Perception & Target Coordinate ---
Perception -[#388E3C]-> MovingLauncher : Target & Bottom State / TF\n(/bucket_opening_tracker/target)\n(/bucket_opening_tracker/bottom)\n(map -> bucket_opening / bucket_bottom)
Perception -[#388E3C]-> FieldTarget : Opponent / Bucket TF\n(map -> opponent_robot / bucket_opening)
FieldTarget -[#388E3C]-> FieldTarget : Static Target TFs\n(map -> bucket_1..3, flag, desk_1..4)
FieldTarget -[#E64A19]-> UDP : Target Relative Yaw Angles\n(/robot/operation/target_angles: Int8MultiArray)

' --- Connections: Master MCU (UDP) & Navigation ---
UDP -[#E64A19]-> TargetMgr : Nav Command & Target ID\n(/robot/navigation_command, /robot/target_id)
UDP -[#E64A19]-> Follower : Nav Command & Target ID\n(/robot/navigation_command, /robot/target_id)
UDP -[#E64A19]-> MovingLauncher : Nav Command & Target ID\n(/robot/navigation_command, /robot/target_id)

TargetMgr -[#1976D2]-> Planner : Goal Pose\n(/goal_pose: PoseStamped)
TargetMgr -[#E64A19]-> UDP : Static Point Belt Speed\n(/robot/operation/belt_launcher_speed)
MovingLauncher -[#E64A19]-> UDP : Dynamic Belt Speed\n(/robot/operation/belt_launcher_speed)

CostmapGen -[#1976D2]-> Planner : Costmap\n(/costmap: OccupancyGrid)
Planner -[#1976D2]-> Follower : Planned Path\n(/planned_path: Path)

Follower -[#E64A19]-> UDP : Velocity Command & Nav Status\n(/robot/operation/cmd_vel: Twist)\n(/robot/operation/navigation_status: UInt8)

' --- Connections: Vision & Shot Management ---
RealSense -[#7B1FA2]-> ShotMgr : Measured Cloth Trajectory & Position\n(/cloth/measured_path, /cloth/position)
UDP -[#7B1FA2]-> ShotMgr : Launcher Feedback & Shot Trigger\n(/robot/feedback/shot_count, /robot/target_id)\n(/robot/feedback/belt_launcher/*)\n(/robot/feedback/drive_battery_voltage, drive_current)

' --- Technical Notes ---
note right of Localizer
  <b>ESDF Localization Fusion:</b>
  GPU-accelerated 3D ESDF matching using Livox MID-360
  fused with Lakibeam 2D LiDAR for rear wall fallback,
  IMU rotational deskew, and linear velocity prediction.
end note

note right of Perception
  <b>Dynamic Tracking:</b>
  Filters dynamic point clouds from localizer,
  tracks moving bucket opening/bottom and opponent robot,
  and guards transform freshness.
end note

note bottom of FieldTarget
  <b>Target Angle Quantization:</b>
  Calculates relative yaw angles to targets from base_link
  and quantizes into 6ch signed Int8 array for mainboard aiming.
end note

note bottom of MovingLauncher
  <b>Moving Bucket Launcher:</b>
  Computes continuous launcher belt velocity
  based on real-time relative distance/velocity to moving bucket.
end note

note bottom of ShotMgr
  <b>Performance & Trial Logging:</b>
  Synchronizes launcher electrical telemetry (speed, voltage, current)
  with 3D camera ballistic trajectory and landing estimates upon shot trigger.
end note

@enduml
