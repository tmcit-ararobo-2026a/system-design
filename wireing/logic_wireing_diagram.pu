@startuml logic wireing diagram

title Signal & Communication Topology Diagram (CAN / Ethernet / EMS)

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam shadowing false
scale max 4960*3508

skinparam component {
  BackgroundColor #F8F9FA
  BorderColor #444444
  FontSize 12
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
  FontSize 13
  FontStyle bold
}

skinparam ArrowFontSize 11

legend top left
  |<back:#1E88E5>   </back> CAN Bus (CAN1 / CAN2 / CAN3) + 5V |
  |<back:#212121>   </back> Ethernet Network |
  |<back:#E53935>   </back> Emergency Stop (EMS) Digital Signal |
  Refer to Power Distribution Diagram for DC power feeds
endlegend

' --- Master Controller Layer (Top Authority) ---
package "Master Control System" #E3F2FD {
  component "**GN10 Mainboard**\n[Master Authority / Core Real-Time Controller]" as Mainboard #BBDEFB
}

' --- High-Level Compute & Sensors ---
package "Host Compute & Vision (Ethernet Network)" #EDE7F6 {
  component "Jetson\n(Host Computer)" as Jetson #D1C4E9
  component "L2 Ethernet Switch" as L2SW
  component "MID-360S\n(3D LiDAR)" as MID360S
  component "Lakibeam 1\n(2D LiDAR)" as Lakibeam1
}

' --- Distributed CAN Subsystems ---
package "Actuator & IO Domain (CAN1)" #FFF9C4 {
  component "Trinity Device Controller\n(24V Driver)" as Trinity24V
  component "HTMD v2.2c\n(Motor Driver)" as HTMD
  component "KNI-Servo\n(Servo / LED)" as KNI_Servo
}

package "Power & Safety Domain (CAN2 / EMS)" #FFE0B2 {
  component "Power Management Board\n(PMB)" as PMB
  component "Voltage Converter Board" as VConv
  component "Remote EMS Board\n(Powered via CAN+5V)" as RemoteEMSBoard
  component "Emergency Stop SW\n(Local EMS)" as EMS_SW
  component "Remote EMS SW" as RemoteEMS_SW
}

package "Motor ESC Domain (CAN3 / Drivetrain)" #F3E5F5 {
  component "C620 ESC Hub" as C620Hub
  component "C610 ESC Hub" as C610Hub
  component "VESC Hub" as VESCHub

  component "C620 (Front / Left / Right)" as C620_Group
  component "C610 x4" as C610
  component "VESC (Launcher)" as VESC
}

' --- Ethernet Topology ---
Mainboard .[#212121].> L2SW : Ethernet
Jetson .[#212121].> L2SW : Ethernet
MID360S .[#212121].> L2SW : Ethernet
Lakibeam1 .[#212121].> L2SW : Ethernet

' --- Master Control Routing: CAN1 ---
Mainboard -[#1E88E5]-> Trinity24V : CAN1 Bus
Trinity24V -[#1E88E5]-> HTMD : CAN1
HTMD -[#1E88E5]-> KNI_Servo : CAN1

' --- Master Control Routing: CAN2 ---
Mainboard -[#1E88E5]-> VConv : CAN2
VConv -[#1E88E5]-> PMB : CAN2
PMB -[#1E88E5]-> RemoteEMSBoard : CAN2 + 5V Power

' --- Master Control Routing: CAN3 ---
Mainboard -[#1E88E5]-> C620Hub : CAN3 Bus
C620Hub -[#1E88E5]-> C610Hub : CAN3
C610Hub -[#1E88E5]-> VESCHub : CAN3

' --- Isolated Sub-tier ESC Control ---
C620Hub .[#1E88E5].> C620_Group : Isolated CAN
C610Hub .[#1E88E5].> C610 : Isolated CAN
VESCHub .[#1E88E5].> VESC : Isolated CAN

' --- Safety / EMS Signals ---
EMS_SW -[#E53935]-> PMB : Digital Stop
RemoteEMS_SW -[#E53935]-> RemoteEMSBoard : Digital Stop

@enduml