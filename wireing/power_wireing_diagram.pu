@startuml PowerWiringDiagram_v5_Power

title Power Distribution Diagram

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F5F7FA
  BorderColor #444444
  FontSize 13
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888888
  FontSize 14
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam shadowing false
scale max 4960*3508

legend top left
  |<back:#E53935>   </back> 5S Drive Power (18.5–21V) |
  |<back:#FB8C00>   </back> 5S Logic Power A (18.5–21V) |
  |<back:#FDD835>   </back> 5S Logic Power B (18.5–21V) |
  |<back:#6D4C41>   </back> External AC/DC Input (19V) |
  |<back:#00897B>   </back> LPMB UPS Bus Output (11.1–16.8V Variable) |
  |<back:#43A047>   </back> 24V Output (Trinity Device Controller) |
  |<back:#C0CA33>   </back> 12V Output (Voltage Converter Board) |
  |<back:#8E24AA>   </back> 5V Output (USB / Servo Driver) |
  |<back:#D81B60>   </back> Analog Signal (Variable Voltage) |
  |<back:#B0BEC5>   </back> Pneumatic Piping (Non-Electrical) |
  Refer to CAN/Signal Diagram for signal lines
endlegend

package "Power Sources" {
  component "LiPo 5S (Drive)" as Lipo5S
  component "LiPo 5S (Logic A)" as Lipo5S1
  component "LiPo 5S (Logic B)" as Lipo5S2
  component "External AC/DC\n19V" as External_DC
}

package "Drive Power Stage" #EAF3FF {
  component "Fuse (30A)" as Fuse30A
  component "Voltage Meter (5S)" as VMeter5S
  component "Power Management Board\n(PMB)" as PMB
  component "Power Distribution Board\n(PDB / High Capacitance)" as PDB
}

Lipo5S -[#E53935]-> Fuse30A
Fuse30A -[#E53935]-> VMeter5S
VMeter5S -[#E53935]-> PMB
PMB -[#E53935]-> PDB

package "Logic Power Stage" #F0F6E7 {
  component "Fuse (10A)" as Fuse10A1
  component "Fuse (10A)" as Fuse10A2
  component "Logic Power Management Board\n(LPMB / UPS)" as LPMB
}

Lipo5S1 -[#FB8C00]-> Fuse10A1
Fuse10A1 -[#FB8C00]-> LPMB
Lipo5S2 -[#FDD835]-> Fuse10A2
Fuse10A2 -[#FDD835]-> LPMB
External_DC -[#6D4C41]-> LPMB

package "Main Compute & Sensors" #EDE7F6 {
  component Jetson
  component "Mainboard" as Mainboard
  component "MID-360S\n(3D LiDAR)" as MID360S
  component "Lakibeam 1\n(2D LiDAR)" as Lakibeam1
  component "L2 Switch" as L2SW
}

LPMB -[#00897B]-> Jetson
LPMB -[#00897B]-> Mainboard
LPMB -[#00897B]-> MID360S
LPMB -[#00897B]-> Lakibeam1
Jetson -[#8E24AA]-> L2SW : USB 5V

package "Drivetrain" {
  component "C620 (Front)" as C620_F
  component "C620 (Left)" as C620_L
  component "C620 (Right)" as C620_R
  component "M3508 (Front)" as Wheel_F
  component "M3508 (Left)" as Wheel_L
  component "M3508 (Right)" as Wheel_R
}

PDB -[#E53935]-> C620_F
C620_F -[#E53935]-> Wheel_F
PDB -[#E53935]-> C620_L
C620_L -[#E53935]-> Wheel_L
PDB -[#E53935]-> C620_R
C620_R -[#E53935]-> Wheel_R

package "Belt Launcher" {
  component "Capacitor Array" as C_Arr2
  component "VESC" as VESC
  component "BLDC-NEO" as BLDC_NEO
}

PDB -[#E53935]-> C_Arr2
C_Arr2 -[#E53935]-> VESC
VESC -[#E53935]-> BLDC_NEO

package "Mechanisms & Actuators" {
  component "C610 x4" as C610
  component "M2006 x4" as M2006
  component "HTMD v2.2c\n(Motor Driver)" as HTMD
  component "RS385\n(DC Motor)" as RS385
}

PDB -[#E53935]-> C610
C610 -[#E53935]-> M2006
PDB -[#E53935]-> HTMD
HTMD -[#E53935]-> RS385

package "Status Indicators" {
  component "KNI-Servo" as KNI_LED
  component "LED" as LED
}

PDB -[#E53935]-> KNI_LED
KNI_LED -[#8E24AA]-> LED

package "Pneumatic System" #E8F5E9 {
  component "Trinity Device Controller\n(24V)" as Trinity24V
  component "Air Regulator" as AirReg
  component "Air Launcher 1" as Air_Desk1
  component "Air Launcher 2" as Air_Desk2
}

PDB -[#E53935]-> Trinity24V
Trinity24V -[#43A047]-> Air_Desk1 : Solenoid Valve
Trinity24V -[#43A047]-> Air_Desk2 : Solenoid Valve
Trinity24V -[#43A047]-> AirReg : 24V

@enduml