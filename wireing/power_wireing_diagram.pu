@startuml PowerWiringDiagram_v4_Power

title 電源系統図 v3 (Power)

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F5F7FA
  BorderColor #444444
  FontSize 13
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888888
  FontSize 14
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam shadowing false

legend top left
  |<back:#CC0000>   </back> 実線(赤) | 電源ライン (Power) |
  制御系統は別図「制御系統図」を参照
endlegend

' =====================================================
package "バッテリー" {
  component "Lipo 5S\n(駆動用主電源)" as Lipo5S
}

' =====================================================
package "駆動系 電源ライン (5S)" #EAF3FF {
  component "Fuse 30A" as Fuse30A
  component "VoltageMeter 5S\n(電圧監視)" as VMeter5S
  component "PowerManagementBoard\n(EMS連動 主電源遮断)" as PMB
  component "PowerDistributionBoard\n(電源分配 / 大容量C搭載)" as PDB
}

Lipo5S -[#CC0000]-> Fuse30A
Fuse30A -[#CC0000]-> VMeter5S
VMeter5S -[#CC0000]-> PMB
PMB -[#CC0000]-> PDB

note right of PDB
  大容量キャパシタ搭載。
  複数アクチュエータ同時動作時の
  瞬間的電流ピークを吸収し、
  バス電圧の落ち込みを抑制する。
end note

' =====================================================
package "足回り (ホイール)" {
  component VESC
  component "BLDC-NEO" as BLDC_NEO
  component "XT60→XT30\n(Front)" as XT_F
  component "XT60→XT30\n(Left)" as XT_L
  component "XT60→XT30\n(Right)" as XT_R
  component "C620 (Front)" as C620_F
  component "C620 (Left)" as C620_L
  component "C620 (Right)" as C620_R
  component "ホイール M3508\n(Front)" as Wheel_F
  component "ホイール M3508\n(Left)" as Wheel_L
  component "ホイール M3508\n(Right)" as Wheel_R
}

PDB -[#CC0000]-> VESC
VESC -[#CC0000]-> BLDC_NEO
PDB -[#CC0000]-> XT_F
XT_F -[#CC0000]-> C620_F
C620_F -[#CC0000]-> Wheel_F
PDB -[#CC0000]-> XT_L
XT_L -[#CC0000]-> C620_L
C620_L -[#CC0000]-> Wheel_L
PDB -[#CC0000]-> XT_R
XT_R -[#CC0000]-> C620_R
C620_R -[#CC0000]-> Wheel_R

' =====================================================
package "バケツアーム系" {
  component "BucketArmHoldC610" as BAH_C610
  component "BucketArmHold M2006" as BAH_M2006
  component "HTMD v2.2c\n(高さ制御モータードライバ)" as HTMD
  component "BucketArmHight\nMS-385PH" as BAHeight
}

PDB -[#CC0000]-> BAH_C610
BAH_C610 -[#CC0000]-> BAH_M2006
PDB -[#CC0000]-> HTMD
HTMD -[#CC0000]-> BAHeight

' =====================================================
package "装填系" {
  component "LoadingShiftC610" as LS_C610
  component "LoadingShift M2006" as LS_M2006
  component "LoadingRotateC610" as LR_C610
  component "LoadingRotate M2006" as LR_M2006
}

PDB -[#CC0000]-> LS_C610
LS_C610 -[#CC0000]-> LS_M2006
PDB -[#CC0000]-> LR_C610
LR_C610 -[#CC0000]-> LR_M2006

' =====================================================
package "机用アーム系" {
  component "DeskArmC610" as DA_C610
  component "DeskArmHookPos M2006" as DA_M2006
  component "KNI-Servo\n(5V降圧)" as KNI_Servo
  component "DeskArmHold MG996R" as DA_Servo
  component "KNI-Servo-LED\n(5V降圧)" as KNI_LED
  component "LED\nBeltVel" as LED_Belt
  component "LED\nAirLauncherSelect" as LED_AirSel
  component "LED\nRobotState" as LED_State
  component "LED\nTargetRollAngle" as LED_Roll
}

PDB -[#CC0000]-> DA_C610
DA_C610 -[#CC0000]-> DA_M2006
PDB -[#CC0000]-> KNI_Servo
KNI_Servo -[#CC0000]-> DA_Servo
PDB -[#CC0000]-> KNI_LED
KNI_LED -[#CC0000]-> LED_Belt
KNI_LED -[#CC0000]-> LED_AirSel
KNI_LED -[#CC0000]-> LED_State
KNI_LED -[#CC0000]-> LED_Roll

' =====================================================
package "空圧系統" #E8F5E9 {
  component "TrinityDeviceController\n24V (24V昇圧)" as Trinity24V
  component ToggleSW
  component "AirRegulatorControlBoard" as ARCB
  component "AirRegulator" as AirReg
  component "AirLauncher\n(旗)" as Air_Flag
  component "AirLauncher\n(机1)" as Air_Desk1
  component "AirLauncher\n(机2)" as Air_Desk2
}

PDB -[#CC0000]-> Trinity24V
Trinity24V --> Air_Flag : 電磁弁
Trinity24V --> Air_Desk1 : 電磁弁
Trinity24V --> Air_Desk2 : 電磁弁
Trinity24V --> ARCB : 24V
ARCB --> ToggleSW : 電圧可変信号
ToggleSW --> AirReg : 電圧可変信号
AirReg --> Air_Flag : 空気圧調整

' =====================================================
package "ESC Hub 群 (CAN/電源 絶縁)" #FCE4EC {
  component "C620 ESCHub" as C620Hub
  component "C610 ESCHub" as C610Hub
  component "VESC ESCHub" as VESCHub
}

PDB -[#CC0000]-> C620Hub
PDB -[#CC0000]-> C610Hub
PDB -[#CC0000]-> VESCHub

@enduml