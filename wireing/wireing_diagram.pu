@startuml wireing diagram

title Integrated System Diagram (Power, CAN, Ethernet & EMS)

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam shadowing false
scale max 4960*3508

skinparam component {
  BackgroundColor #F8F9FA
  BorderColor #444444
  FontSize 12
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
  FontSize 13
  FontStyle bold
}

skinparam ArrowFontSize 10

legend top left
  <b>== [Power Lines (Solid)] ==</b>
  |<back:#E53935>   </back> 5S Drive Power (18.5–21V) |
  |<back:#FB8C00>   </back> 5S Logic Power A (18.5–21V) |
  |<back:#FDD835>   </back> 5S Logic Power B (18.5–21V) |
  |<back:#6D4C41>   </back> External AC/DC Input (19V) |
  |<back:#00897B>   </back> LPMB UPS Bus Output (11.1–16.8V Variable) |
  |<back:#43A047>   </back> 24V Output (Trinity Device Controller) |
  |<back:#8E24AA>   </back> 5V Power (USB / Auxiliary) |
  <b>== [Signal & Communication (Dotted / Dashed)] ==</b>
  |<back:#1E88E5>   </back> CAN Bus (CAN1 / CAN2 / CAN3) + 5V |
  |<back:#212121>   </back> Ethernet Network |
  |<back:#D81B60>   </back> Emergency Stop (EMS) Digital Signal |
endlegend

' ==========================================
' 1. Master Controller Layer (Top Authority)
' ==========================================
package "Master Control System" #E3F2FD {
  component "**GN10 Mainboard**\n[Master Authority / Core Real-Time Controller]" as Mainboard #BBDEFB
}

' ==========================================
' 2. Power Generation & Distribution Layers
' ==========================================
package "Power Sources" {
  component "LiPo 5S (Drive)" as Lipo5S
  component "LiPo 5S (Logic A)" as Lipo5S1
  component "LiPo 5S (Logic B)" as Lipo5S2
  component "External AC/DC\n19V" as External_DC
}

package "Drive Power Stage" #EAF3FF {
  component "Fuse (30A)" as Fuse30A
  component "Voltage Meter (5S)" as VMeter5S
  component "Power Management Board\n(PMB)" as PMB #FFE0B2
  component "Power Distribution Board\n(PDB / High Capacitance)" as PDB
}

package "Logic Power Stage" #F0F6E7 {
  component "Fuse (5A)" as Fuse5A1
  component "Fuse (5A)" as Fuse5A2
  component "Logic Power Management Board\n(LPMB / UPS)" as LPMB
}

' Power Flow: Drive
Lipo5S -[#E53935]-> Fuse30A
Fuse30A -[#E53935]-> VMeter5S
VMeter5S -[#E53935]-> PMB
PMB -[#E53935]-> PDB

' Power Flow: Logic
Lipo5S1 -[#FB8C00]-> Fuse5A1
Fuse5A1 -[#FB8C00]-> LPMB
Lipo5S2 -[#FDD835]-> Fuse5A2
Fuse5A2 -[#FDD835]-> LPMB
External_DC -[#6D4C41]-> LPMB

' ==========================================
' 3. High-Level Compute & Network
' ==========================================
package "Host Compute & Vision" #EDE7F6 {
  component "Jetson\n(Host Computer)" as Jetson #D1C4E9
  component "L2 Ethernet Switch" as L2SW
  component "MID-360S\n(3D LiDAR)" as MID360S
  component "Lakibeam 1\n(2D LiDAR)" as Lakibeam1
}

' Power Flow: LPMB to Compute & Sensors
LPMB -[#00897B]-> Mainboard : UPS Bus
LPMB -[#00897B]-> Jetson : UPS Bus
LPMB -[#00897B]-> MID360S : UPS Bus
LPMB -[#00897B]-> Lakibeam1 : UPS Bus
Jetson -[#8E24AA]-> L2SW : USB 5V

' Ethernet Topology
Mainboard .[#212121].> L2SW : Ethernet
Jetson .[#212121].> L2SW : Ethernet
MID360S .[#212121].> L2SW : Ethernet
Lakibeam1 .[#212121].> L2SW : Ethernet

' ==========================================
' 4. Safety & Power Domain (CAN2 / EMS)
' ==========================================
package "Safety & Monitoring Domain (CAN2 / EMS)" #FFF3E0 {
  component "Voltage Converter Board" as VConv
  component "Remote EMS Board\n(Powered via CAN+5V)" as RemoteEMSBoard
  component "Emergency Stop SW\n(Local EMS)" as EMS_SW
  component "Remote EMS SW" as RemoteEMS_SW
}

' CAN2 Chain
Mainboard .[#1E88E5].> VConv : CAN2
VConv .[#1E88E5].> PMB : CAN2
PMB .[#1E88E5].> RemoteEMSBoard : CAN2 + 5V

' EMS Safety Signals
EMS_SW .[#D81B60].> PMB : Digital Stop
RemoteEMS_SW .[#D81B60].> RemoteEMSBoard : Digital Stop

' ==========================================
' 5. Actuator, IO & Pneumatics (CAN1)
' ==========================================
package "Actuator & Pneumatic Domain (CAN1)" #FFF9C4 {
  component "Trinity Device Controller\n(24V Driver)" as Trinity24V
  component "HTMD v2.2c\n(Motor Driver)" as HTMD
  component "RS385\n(DC Motor)" as RS385
  component "KNI-Servo\n(Servo / LED)" as KNI_Servo
  component "Status LED" as LED
  component "Air Regulator" as AirReg
  component "Air Launcher 1" as Air_Desk1
  component "Air Launcher 2" as Air_Desk2
}

' Power Feeds from PDB
PDB -[#E53935]-> Trinity24V : 5S Drive
PDB -[#E53935]-> HTMD : 5S Drive
PDB -[#E53935]-> KNI_Servo : 5S Drive

' Actuator Power Lines
HTMD -[#E53935]-> RS385
KNI_Servo -[#8E24AA]-> LED : 5V Output
Trinity24V -[#43A047]-> Air_Desk1 : Solenoid (24V)
Trinity24V -[#43A047]-> Air_Desk2 : Solenoid (24V)
Trinity24V -[#43A047]-> AirReg : 24V

' CAN1 Bus Routing
Mainboard .[#1E88E5].> Trinity24V : CAN1
Trinity24V .[#1E88E5].> HTMD : CAN1
HTMD .[#1E88E5].> KNI_Servo : CAN1

' ==========================================
' 6. Drivetrain & Launcher ESCs (CAN3)
' ==========================================
package "Drivetrain & Mechanism ESC Domain (CAN3)" #F3E5F5 {
  component "C620 ESC Hub" as C620Hub
  component "C610 ESC Hub" as C610Hub
  component "VESC Hub" as VESCHub

  component "C620 (Front/Left/Right)" as C620_Group
  component "M3508 Wheels (x3)" as Wheel_Group
  component "C610 (x4)" as C610
  component "M2006 (x4)" as M2006
  component "Capacitor Array" as C_Arr2
  component "VESC" as VESC
  component "BLDC-NEO" as BLDC_NEO
}

' CAN3 Master Daisy-Chain
Mainboard .[#1E88E5].> C620Hub : CAN3
C620Hub .[#1E88E5].> C610Hub : CAN3
C610Hub .[#1E88E5].> VESCHub : CAN3

' Isolated Sub-tier CAN
C620Hub .[#1E88E5].> C620_Group : Isolated CAN
C610Hub .[#1E88E5].> C610 : Isolated CAN
VESCHub .[#1E88E5].> VESC : Isolated CAN

' Power & Motor Drive
PDB -[#E53935]-> C620_Group : 5S Drive
C620_Group -[#E53935]-> Wheel_Group

PDB -[#E53935]-> C610 : 5S Drive
C610 -[#E53935]-> M2006

PDB -[#E53935]-> C_Arr2 : 5S Drive
C_Arr2 -[#E53935]-> VESC
VESC -[#E53935]-> BLDC_NEO

@enduml